# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY must be a JWT — it MUST start with "eyJ".
# Find it in: Supabase dashboard → Settings → API → "anon" "public" key.
# If this key is missing or does not start with "eyJ", supabaseClient.ts sets supabase=null
# and the app automatically falls back to mock-auth mode:
#   - Phone OTP login works with code "123456" in dev (NODE_ENV=development)
#   - Session is stored in localStorage instead of Supabase
# The app will still render fully in mock-auth mode — no white screen.
VITE_SUPABASE_ANON_KEY=your-jwt-anon-key-here

# AI Services (Optional - will fall back to local responses if missing)
VITE_OPENAI_API_KEY=sk-...
VITE_GEMINI_API_KEY=...

# Weather Service (Optional - will fall back to mock data if missing)
VITE_OPENWEATHER_API_KEY=...

# Identification Service (Optional)
VITE_PLANT_ID_API_KEY=...

# Application Configuration
VITE_USE_MOCK_APIS=false
VITE_APP_ENV=development
